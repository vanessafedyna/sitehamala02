# Exemple production uniquement.
# Copier vers un fichier non versionne (.env sur le serveur, ou variables d'environnement OS).
# Ne jamais commiter de secrets reels.
# Remplir les valeurs vides directement sur l'hebergeur.

# Application
APP_ENV=prod
APP_DEBUG=false
APP_BASE_URL=/
APP_PUBLIC_URL=https://soracollectionmali.com
APP_TIMEZONE=Africa/Bamako

# Base de donnees
# Utiliser un compte applicatif dedie avec privileges minimaux sur cette base seulement.
# Exemple: SELECT, INSERT, UPDATE, DELETE.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# SMTP production
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SORA Collection

# Sessions
ADMIN_SESSION_IDLE_TIMEOUT=
CLIENT_SESSION_LIFETIME=

# WhatsApp - V1
# Le WhatsApp public simple n'est pas configure par .env.
# Il est gere en base via la table settings, cle shop_whatsapp_number.
# Numero public attendu: +22392828271
# L'API WhatsApp automatique est desactivee pour la V1 et prevue pour la V2.
# Ne pas ajouter de variables WHATSAPP_* tant que le code ne les utilise pas.

# PayDunya - V1
# Le paiement en ligne est desactive pour la V1.
# Ne pas mettre de cles PayDunya dans ce modele production.
# Paiement a la livraison uniquement.
