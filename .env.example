# Exemple local / developpement.
# Ne jamais mettre de secrets reels dans un fichier versionne.
# En production, copier les placeholders depuis .env.production.example
# et definir les vraies valeurs sur le serveur.

# Application
APP_ENV=dev
APP_DEBUG=true
APP_BASE_URL=/sitehamala/
# Local: laisser vide si vous utilisez localhost/XAMPP et l'auto-detection.
# Production: definir l'URL publique absolue (ex: https://boutique.example.com)
APP_PUBLIC_URL=

# Base de donnees
# Local/XAMPP uniquement: `root` peut rester pratique en developpement.
# Ne pas reutiliser cette valeur en production.
DB_HOST=127.0.0.1
DB_NAME=malishop
DB_USER=root
DB_PASS=


# SMTP local/dev
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.test
SMTP_FROM_NAME=SORA Collection (Local)
